{
  "name": "setup-unirtm",
  "description": "GitHub Action to setup UniRTM (Uni Runtime and Tools Manager)",
  "version": "0.3.0",
  "author": "Snowdream Tech",
  "private": true,
  "homepage": "https://github.com/snowdreamtech/setup-unirtm",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/snowdreamtech/setup-unirtm.git"
  },
  "bugs": {
    "url": "https://github.com/snowdreamtech/setup-unirtm/issues"
  },
  "keywords": [
    "actions",
    "node",
    "setup",
    "unirtm"
  ],
  "exports": {
    ".": "./dist/index.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "bundle": "npm run format:write && npm run package",
    "ci-test": "npx jest",
    "format:write": "npx prettier --write .",
    "format:check": "npx prettier --check .",
    "lint": "npx eslint .",
    "package:index": "npx -y esbuild src/index.ts --bundle --platform=node --target=node20 --outfile=dist/index.js",
    "package:post": "npx -y esbuild src/post.ts --bundle --platform=node --target=node20 --outfile=dist/post.js",
    "package": "npm run package:index && npm run package:post",
    "package:watch": "npm run package -- --watch",
    "test": "npx jest",
    "all": "npm run format:write && npm run lint && npm run test && npm run package",
    "prepare": "husky"
  },
  "license": "MIT",
  "jest": {
    "preset": "ts-jest",
    "verbose": true,
    "clearMocks": true,
    "testEnvironment": "node",
    "moduleFileExtensions": [
      "js",
      "ts"
    ],
    "testMatch": [
      "**/*.test.ts"
    ],
    "testPathIgnorePatterns": [
      "/node_modules/",
      "/dist/"
    ],
    "transform": {
      "^.+\\.ts$": "ts-jest"
    },
    "coverageReporters": [
      "json-summary",
      "text",
      "lcov"
    ],
    "collectCoverage": true,
    "collectCoverageFrom": [
      "./src/**"
    ]
  },
  "dependencies": {
    "@actions/cache": "6.0.1",
    "@actions/core": "3.0.1",
    "@actions/exec": "3.0.0",
    "@actions/glob": "0.7.0",
    "handlebars": "4.7.9"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@jest/globals": "30.4.1",
    "@types/handlebars": "4.1.0",
    "@types/jest": "30.0.0",
    "@types/node": "25.9.1",
    "@typescript-eslint/eslint-plugin": "8.60.1",
    "@typescript-eslint/parser": "8.60.1",
    "esbuild": "0.28.0",
    "eslint": "10.4.1",
    "eslint-plugin-jest": "29.15.2",
    "eslint-plugin-prettier": "5.5.6",
    "globals": "17.6.0",
    "husky": "9.1.7",
    "jest": "30.4.2",
    "jiti": "2.7.0",
    "lint-staged": "17.0.7",
    "prettier": "3.8.3",
    "ts-jest": "29.4.11",
    "typescript": "6.0.3",
    "typescript-eslint": "8.60.1"
  },
  "lint-staged": {
    "*.{ts,js}": [
      "eslint --fix",
      "prettier --write"
    ],
    "*.{md,yml,json}": [
      "prettier --write"
    ]
  }
}
